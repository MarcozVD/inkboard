{
	"useTabs": true,
	"singleQuote": true,
	"printWidth": 120,
	"trailingComma": "none",
	"endOfLine": "lf",
	"plugins": ["prettier-plugin-svelte"],
	"overrides": [
		{
			"files": "*.svelte",
			"options": { "parser": "svelte" }
		},
		{
			"files": "src/lib/components/BoardCanvas.svelte",
			"options": { "parser": "svelte", "printWidth": 400 }
		}
	]
}
