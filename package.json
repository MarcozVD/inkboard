{
	"name": "inkboard",
	"private": true,
	"version": "0.5.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"bench": "playwright test --config bench/playwright.bench.config.ts",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{ts,svelte,css,js}\" \"e2e/**/*.ts\" \"bench/**/*.ts\" \"*.{ts,js,json}\"",
		"format:check": "prettier --check \"src/**/*.{ts,svelte,css,js}\" \"e2e/**/*.ts\" \"bench/**/*.ts\" \"*.{ts,js,json}\"",
		"tauri": "tauri"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tauri-apps/cli": "^2.11.4",
		"@types/rbush": "^4.0.0",
		"eslint": "^10.11.0",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.10.2",
		"globals": "^17.13.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"sharp": "^0.35.4",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"yaml": "^2.9.1"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.11.1",
		"@tauri-apps/plugin-clipboard-manager": "^2.3.2",
		"@tauri-apps/plugin-dialog": "^2.7.2",
		"@tauri-apps/plugin-fs": "^2.5.1",
		"@tauri-apps/plugin-process": "^2.3.1",
		"@tauri-apps/plugin-updater": "^2.12.0",
		"perfect-freehand": "^1.2.3",
		"rbush": "^4.0.1",
		"uuid": "^14.0.2"
	},
	"packageManager": "pnpm@10.33.0"
}
